; GR IV 01.11.10.07 manual-off comparison v5; user reports no wake; returned SD log still pending.
; Camera ON at 0s, GF-2 ON immediately; lamp OFF at 30s, ON at 90s.
; Keep camera ON for 150s. Do not half-press or shoot during this test.
; C0/C1 baseline, manual-off C0/A6 01 02/C0, manual-on C0/C1/C2.
; Later boots restore checking before skipping the existing HSM5.TXT marker.

mpause 15000
sendln 'HotshoeCheckDisable 0'
r = result
filesearch 'C:\HSM5.TXT'
if result = 1 then
    end
endif
filecreate f 'C:\HSM5.TXT'
if f < 0 then
    end
endif
filewriteln f 'Manual-off comparison v5; each step journaled'
filewriteln f 'Initial restore:'
int2str reply r
filewriteln f reply
fileclose f
if r != 0 then
    end
endif
s = -1
z = -999
a = -999
sendln 'SYS_buildinfo'
z = result
if z != 0 then
    goto h5_abort
endif
sendln 'HotshoeCommType1 0 0 0'
z = result
if z != 0 then
    goto h5_abort
endif
sendln 'HotshoeCommType1 0 1 0'
z = result
if z != 0 then
    goto h5_abort
endif
s = 0

:h5_next
x = -999
y = -999
t = -999
r = -999
fileopen f 'C:\HSM5.TXT' 1
if f < 0 then
    goto h5_abort
endif
filewriteln f 'BEGIN step:'
int2str reply s
filewriteln f reply
fileclose f
if s = 0 then
    goto h5_open
endif
if s = 2 then
    goto h5_open
endif
if s = 6 then
    goto h5_open
endif
goto h5_select

:h5_open
sendln 'HotshoeCheckDisable 1'
z = result
if z != 0 then
    goto h5_abort
endif
mpause 1000

:h5_select
if s = 1 then
    goto h5_c1
endif
if s = 3 then
    goto h5_a6
endif
if s = 5 then
    goto h5_status
endif
if s = 7 then
    if a != 165 then
        t = -998
        goto h5_finish_step
    endif
    goto h5_c1
endif
if s = 8 then
    goto h5_status
endif
n = 1
sendln 'HotshoeCommType1 1 192 1'
t = result
goto h5_received

:h5_c1
n = 2
sendln 'HotshoeCommType1 1 193 2'
t = result
goto h5_received

:h5_status
if a != 165 then
    t = -998
    goto h5_finish_step
endif
n = 2
sendln 'HotshoeCommType1 1 194 2'
t = result
goto h5_received

:h5_a6
sendln 'HotshoeCommType1 0 0 1'
z = result
if z != 0 then
    goto h5_abort
endif
sendln 'HotshoeCommType1 0 1 2'
z = result
if z != 0 then
    goto h5_abort
endif
n = 0
sendln 'HotshoeCommType1 1 166 2'
t = result

:h5_received
z = t
if t != 0 then
    goto h5_abort
endif
if n > 0 then
    sendln 'HotshoeCommType1 2 0'
    x = result
    if x < 0 then
        z = x
        goto h5_abort
    endif
endif
if n = 2 then
    sendln 'HotshoeCommType1 2 1'
    y = result
    if y < 0 then
        z = y
        goto h5_abort
    endif
endif
if n = 1 then
    a = x
endif

:h5_finish_step
if s = 1 then
    sendln 'HotshoeCheckDisable 0'
    r = result
endif
if s = 5 then
    sendln 'HotshoeCheckDisable 0'
    r = result
endif
if s = 8 then
    sendln 'HotshoeCheckDisable 0'
    r = result
endif
fileopen f 'C:\HSM5.TXT' 1
if f < 0 then
    goto h5_abort
endif
filewriteln f 'RX0 / RX1 / local transfer / this-step restore:'
int2str reply x
filewriteln f reply
int2str reply y
filewriteln f reply
int2str reply t
filewriteln f reply
int2str reply r
filewriteln f reply
filewriteln f 'END step:'
int2str reply s
filewriteln f reply
fileclose f
if s = 0 then
    if x != 165 then
        goto h5_abort
    endif
endif
if s = 1 then
    if r != 0 then
        z = r
        goto h5_abort
    endif
    if x != 17 then
        if x != 18 then
            goto h5_abort
        endif
    endif
    mpause 35000
endif
if s = 3 then
    mpause 5000
endif
if s = 5 then
    if r != 0 then
        z = r
        goto h5_abort
    endif
    mpause 45000
endif
s = s + 1
if s < 9 then
    goto h5_next
endif
if r != 0 then
    z = r
    goto h5_abort
endif
fileopen f 'C:\HSM5.TXT' 1
if f < 0 then
    end
endif
filewriteln f 'ALL STEPS COMPLETE; checking restored.'
filewriteln f '-999 means unused/not restored; -998 means query skipped without A5.'
fileclose f
end

:h5_abort
e = z
sendln 'HotshoeCheckDisable 0'
r = result
fileopen f 'C:\HSM5.TXT' 1
if f < 0 then
    end
endif
filewriteln f 'ABORT step / prior local return / final restore:'
int2str reply s
filewriteln f reply
int2str reply e
filewriteln f reply
int2str reply r
filewriteln f reply
fileclose f
end
