; GR IV 01.11.10.07 short recovery + C0-C5 diagnostics v3.
; Restore first on EVERY boot, before the one-shot marker check.
; Literal native calls, no call/while/dynamic sendln/empty strings.
; TX test buffer is zeroed initially and cleared by each native transfer.
; Turn lamp ON after startup; wait 40s. Then normal reboot skips queries.

mpause 15000
sendln 'HotshoeCheckDisable 0'
r = result
filesearch 'C:\HSC3.TXT'
if result = 1 then
    end
endif
filecreate f 'C:\HSC3.TXT'
if f < 0 then
    end
endif
filewriteln f 'Recovery and C0-C5 diagnostics v3'
filewriteln f 'Initial restore:'
int2str reply r
filewriteln f reply
fileclose f
if r != 0 then
    end
endif
k = -1
z = -999
sendln 'SYS_buildinfo'
z = result
if z != 0 then
    goto h3_abort
endif
sendln 'HotshoeCommType1 0 0 0'
z = result
if z != 0 then
    goto h3_abort
endif
sendln 'HotshoeCommType1 0 1 0'
z = result
if z != 0 then
    goto h3_abort
endif
k = 0

:h3_next
x = -999
y = -999
t = -999
fileopen f 'C:\HSC3.TXT' 1
if f < 0 then
    end
endif
filewriteln f 'BEGIN C index:'
int2str reply k
filewriteln f reply
fileclose f
sendln 'HotshoeCheckDisable 1'
z = result
if z != 0 then
    goto h3_abort
endif
mpause 1000
if k = 0 then
    goto h3_c0
endif
if k = 1 then
    goto h3_c1
endif
if k = 2 then
    goto h3_c2
endif
if k = 3 then
    goto h3_c3
endif
if k = 4 then
    goto h3_c4
endif
if k = 5 then
    goto h3_c5
endif
goto h3_abort

:h3_c0
n = 1
sendln 'HotshoeCommType1 1 192 1'
t = result
goto h3_received
:h3_c1
n = 2
sendln 'HotshoeCommType1 1 193 2'
t = result
goto h3_received
:h3_c2
n = 2
sendln 'HotshoeCommType1 1 194 2'
t = result
goto h3_received
:h3_c3
n = 2
sendln 'HotshoeCommType1 1 195 2'
t = result
goto h3_received
:h3_c4
n = 2
sendln 'HotshoeCommType1 1 196 2'
t = result
goto h3_received
:h3_c5
n = 1
sendln 'HotshoeCommType1 1 197 1'
t = result
goto h3_received

:h3_received
z = t
if t != 0 then
    goto h3_abort
endif
sendln 'HotshoeCommType1 2 0'
x = result
if x < 0 then
    z = x
    goto h3_abort
endif
if n = 2 then
    sendln 'HotshoeCommType1 2 1'
    y = result
    if y < 0 then
        z = y
        goto h3_abort
    endif
endif
sendln 'HotshoeCheckDisable 0'
r = result
fileopen f 'C:\HSC3.TXT' 1
if f < 0 then
    end
endif
filewriteln f 'RX0 / RX1 / transfer / restore (-999=unused):'
int2str reply x
filewriteln f reply
int2str reply y
filewriteln f reply
int2str reply t
filewriteln f reply
int2str reply r
filewriteln f reply
filewriteln f 'END C index:'
int2str reply k
filewriteln f reply
fileclose f
if r != 0 then
    end
endif
if k = 0 then
    if x != 165 then
        end
    endif
endif
mpause 500
k = k + 1
if k < 6 then
    goto h3_next
endif
fileopen f 'C:\HSC3.TXT' 1
if f < 0 then
    end
endif
filewriteln f 'ALL SIX QUERIES COMPLETE; normal checking restored.'
fileclose f
end

:h3_abort
sendln 'HotshoeCheckDisable 0'
r = result
fileopen f 'C:\HSC3.TXT' 1
if f < 0 then
    end
endif
filewriteln f 'ABORT: C index / local return / restore:'
int2str reply k
filewriteln f reply
int2str reply z
filewriteln f reply
int2str reply r
filewriteln f reply
fileclose f
end
